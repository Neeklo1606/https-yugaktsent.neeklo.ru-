# /etc/yugaktsent/monitor.env — уведомления сторожа API (chmod 600, владелец root).
# Бот: создать у @BotFather, написать ему /start; chat id — из https://api.telegram.org/bot<TOKEN>/getUpdates
TG_BOT_TOKEN=
TG_CHAT_ID=
# Необязательно:
# WATCHDOG_FAIL_LIMIT=2      # неудач подряд до перезапуска (проверка раз в минуту)
# WATCHDOG_MAX_RESTARTS=3    # перезапусков за 30 минут, дальше только сообщение
# WATCHDOG_DISK_LIMIT=90     # % заполнения диска для предупреждения
